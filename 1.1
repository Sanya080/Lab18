import tkinter as tk
root = tk.Tk()
root.title("Моя вітальна картка")
root.geometry("400x300")
title_label = tk.Label(root, text="Вітаю!", font=("Arial", 18))
title_label.pack(pady=20)
name_label = tk.Label(root, text="Олександр")
name_label.pack()
group_label = tk.Label(root, text="Ваша група")
group_label.pack(pady=10)
close_button = tk.Button(root, text="Закрити", command=root.destroy)
close_button.pack(pady=20)
root.mainloop()
